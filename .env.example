# ===================== 复制成 .env 后按需修改 =====================
# 这个文件不会提交到 GitHub（.gitignore 已忽略 .env）
# 全部项都有默认值：什么都不配也能跑（会走离线假模型 + 降级实现）
# 想看当前实际生效的是哪套实现：python run_cli.py --doctor

# ---------------- 大模型 ----------------
# 不填也能跑：自动切到离线假模型 MockLLM，全流程可演示、评测可复现
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 成本熔断触发后降级到的小模型
LLM_SMALL_MODEL=qwen-turbo
LLM_TEMPERATURE=0
LLM_TIMEOUT=60
# 强制使用离线假模型（true / false）
MOCK_LLM=false

# ---------------- 状态机 ----------------
# auto=有 langgraph 就用它，没有就用自研等价引擎 / langgraph / native
GRAPH_ENGINE=auto
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_SECONDS=120
AGENT_MAX_SAME_CALL=2
AGENT_MAX_NODE_RETRIES=1
# ask=关键动作走人工审批 / allow=自动放行 / deny=自动拒绝
AGENT_CONFIRM_MODE=ask

# ---------------- 意图路由 ----------------
# 低于这个置信度就判定为长尾，交给自主 Agent
ROUTER_CONFIDENCE_THRESHOLD=0.62
# 规则没把握时是否允许用模型兜底分类
ROUTER_USE_LLM=true

# ---------------- 成本熔断 ----------------
SESSION_TOKEN_BUDGET=60000
RUN_TOKEN_BUDGET=20000
COST_WARN_RATIO=0.8
PRICE_PROMPT_PER_1K=0.001
PRICE_COMPLETION_PER_1K=0.002
PRICE_SMALL_PER_1K=0.0002
# 超预算是否自动降级到小模型（false 则直接停止并转人工）
COST_DOWNGRADE=true

# ---------------- 会话记忆 (Redis) ----------------
# 不装 redis 包或连不上 → 自动降级为内存 + JSONL 落盘
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL_SECONDS=3600

# ---------------- 长期偏好 (PostgreSQL) ----------------
# 不装 psycopg 或连不上 → 自动降级为 SQLite
POSTGRES_ENABLED=true
POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/aftersale

# ---------------- 链路追踪 (Langfuse) ----------------
# 没配 Key → Trace 写本地 JSONL（数据形状与 Langfuse 对齐），Bad Case 定位照样能用
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------- 人工协同 ----------------
# 审批超时时间（秒）与超时策略：escalate=转人工工单 / approve / reject
APPROVAL_TIMEOUT_SECONDS=1800
APPROVAL_TIMEOUT_ACTION=escalate
# 低于这个金额且客户风险不高 → 自动放行（"小额免打扰"，避免客服被确认框淹没）
APPROVAL_AUTO_APPROVE_MAX=200

# ---------------- 代码沙箱 ----------------
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT=5
SANDBOX_MAX_OUTPUT=4000

# ---------------- MCP（加分项：内部系统免改动接入）----------------
# 留空则不接入。多个 server 用 ; 分隔。
# 例：MCP_SERVERS=python -m mcp_server.server
MCP_SERVERS=

# ---------------- 存储 ----------------
DB_PATH=data/aftersale.db
TRACE_DIR=data/traces
STATE_DIR=data/state

# ---------------- 测试/评测用 ----------------
# 固定"业务当前时间"，让时效类规则判定完全确定（留空则用真实时间）
# BIZ_NOW=2026-09-30 12:00:00
